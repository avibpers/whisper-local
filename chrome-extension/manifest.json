{
  "manifest_version": 3,
  "name": "Koli for Google Meet",
  "short_name": "Koli Meet",
  "version": "0.2.0",
  "description": "Tells the Koli app on this computer when you join and leave a Meet, who is in it, and Meet's live captions with each speaker's name.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Koli for Google Meet",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "exclude_matches": ["https://meet.google.com/", "https://meet.google.com/landing*"],
      "js": ["meet_channel.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://meet.google.com/*"],
      "exclude_matches": ["https://meet.google.com/", "https://meet.google.com/landing*"],
      "js": ["meet.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["storage", "tabs"],
  "host_permissions": ["http://127.0.0.1:52881/*"]
}
